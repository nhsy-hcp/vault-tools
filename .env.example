# Copy to .env and fill in (`task init` does the copy). Never commit .env.
# Defaults target the local dev stack (compose.yaml, docs/dev-stack.md); point
# VAULT_ADDR and VAULT_TOKEN at another cluster to audit it instead.
export VAULT_ADDR=https://127.0.0.1:8310
export VAULT_TOKEN=root
# PEM CA bundle for the server certificate: the dev stack's CA, generated by
# task up. Use VAULT_SKIP_VERIFY=true instead only for a throwaway server.
export VAULT_CACERT=.tmp/vault/tls/vault-ca.pem
# export VAULT_SKIP_VERIFY=true
# Namespace to start in (default root). Needed only for a token created in a
# child namespace, e.g. admin on HCP Vault Dedicated; --namespace overrides it.
# export VAULT_NAMESPACE=admin

# --- Dev stack ---------------------------------------------------------------
# Host side of the primary's port mapping; must match VAULT_ADDR.
export VAULT_HOST_IP=127.0.0.1
export VAULT_HOST_PORT=8310
# Optional DR secondary (replicates from the primary)
export VAULT_DR_ADDR=https://127.0.0.1:8320
export VAULT_DR_HOST_PORT=8320
# Optional performance secondary (replicates from the primary; accepts client requests)
export VAULT_PR_ADDR=https://127.0.0.1:8340
export VAULT_PR_HOST_PORT=8340
# Community dev server for task up:ce / task test:ce (plain HTTP, in memory)
export CE_PORT=8330
# Enterprise licence for compose.yaml (DR and performance replication for the secondaries)
export VAULT_LICENSE=
export CONTAINER_CLI=docker
export VAULT_IMAGE=docker.io/hashicorp/vault-enterprise:2.1-ent
# export VAULT_CE_IMAGE=docker.io/hashicorp/vault:2.1

# Optional: rules.json for tests/test_rules_parity.py, as a URL or file path.
# Default: vault-ops-skill's main branch on GitHub; the test skips when unreachable.
# export VAULT_OPS_RULES_JSON=path/to/rules.json
# export VAULT_OPS_SCHEMA_JSON=path/to/findings.schema.json   # tests/test_schema_parity.py
# export VAULT_OPS_PARITY_REQUIRED=1   # fail, not skip, when a source is unreachable (CI sets this)

# Optional: override output directories
# export VAULT_TOOLS_OUTPUT_DIR=outputs
# export VAULT_TOOLS_AUDIT_DIR=outputs/audit
